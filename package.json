{
  "name": "quran-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write --unsafe",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "turbo test",
    "db:generate": "pnpm --filter @quran/db db:generate",
    "db:migrate": "pnpm --filter @quran/db db:migrate",
    "build:android": "pnpm --filter @quran/web build:android"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.5.1"
}
