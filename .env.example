# Postgres (Neon free tier or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/quran"

# better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Vercel Cron auth — generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# Transactional email (Resend free tier) — Phase 1
RESEND_API_KEY=""
EMAIL_FROM="Quran Companion <noreply@qurancompanion.eu>"

# FCM service account — sends native AND web (Firebase) push.
# From: Firebase console → Project settings → Service accounts → Generate key.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# Firebase Web Push (FCM in the browser/PWA).
# FIREBASE_WEB_CONFIG: the public firebaseConfig object as one-line JSON, from
#   Firebase console → Project settings → Your apps → Web app → SDK setup.
#   e.g. {"apiKey":"...","authDomain":"...","projectId":"quran-reminder-5d6e8","messagingSenderId":"143501113134","appId":"..."}
# FIREBASE_VAPID_KEY: the "Web Push certificate" key pair (public key), from
#   Firebase console → Cloud Messaging → Web configuration.
FIREBASE_WEB_CONFIG=""
FIREBASE_VAPID_KEY=""
