# Postgres (Neon free tier or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/quran"

# better-auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Vercel Cron auth — generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# Transactional email (Resend free tier) — Phase 1
RESEND_API_KEY=""
EMAIL_FROM="Quran Companion <noreply@qurancompanion.eu>"

# FCM (native push, Phase 5) — service-account JSON path or inline
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
