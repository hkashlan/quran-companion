{
  "name": "@quran/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3010",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node --env-file=../../.env --import tsx/esm scripts/seed.ts",
    "reset:today": "node --env-file=../../.env --import tsx/esm scripts/reset-today.ts --days=3",
    "delete:user": "node --env-file=../../.env --import tsx/esm scripts/delete-user.ts",
    "push": "node --env-file=../../.env --import tsx/esm scripts/send-push.ts",
    "verify": "node --import tsx/esm scripts/verify.ts",
    "icons": "node --import tsx/esm scripts/generate-icons.ts",
    "auth:generate": "pnpm dlx @better-auth/cli generate --config ./src/lib/auth.ts --output ../../packages/db/src/tables/auth.drizzle.ts",
    "build:android": "node --import tsx/esm scripts/build-android.ts",
    "db:migrate": "cd ../../packages/db && pnpm db:migrate",
    "vercel-build": "pnpm db:migrate && vite build"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@quran/db": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "firebase": "^12.15.0",
    "google-auth-library": "^9.15.1",
    "lucide-react": "catalog:",
    "nitro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "^4.8.0",
    "web-push": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@inlang/paraglide-js": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@trapezedev/configure": "^7.1.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv": "catalog:",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
