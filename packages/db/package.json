{
  "name": "@quran/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": {
      "types": "./src/db.ts",
      "import": "./src/db.ts"
    },
    "./schema": {
      "types": "./src/tables/schema.gen.ts",
      "import": "./src/tables/schema.gen.ts"
    },
    "./tables/*": {
      "types": "./src/tables/*.ts",
      "import": "./src/tables/*.ts"
    },
    "./repositories/*": {
      "types": "./src/repositories/*.repo.ts",
      "import": "./src/repositories/*.repo.ts"
    },
    "./validation/*": {
      "types": "./src/validation/*.schema.ts",
      "import": "./src/validation/*.schema.ts"
    },
    "./domain/*": {
      "types": "./src/domain/*.ts",
      "import": "./src/domain/*.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx scripts/migrate-prod.ts",
    "db:push": "drizzle-kit push",
    "db:barrels": "tsx scripts/generate-barrels.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "^4.21.0",
    "vitest": "^4.1.8"
  }
}
